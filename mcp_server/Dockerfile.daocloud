# 使用 DaoCloud 镜像源
FROM docker.m.daocloud.io/library/python:3.11-slim

WORKDIR /app

# 使用国内 pip 源加速
COPY requirements.txt .
RUN pip install --no-cache-dir \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    -r requirements.txt

# 复制代码
COPY app/ ./app/
COPY config.yaml .

# 暴露端口
EXPOSE 8000

# 启动
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
