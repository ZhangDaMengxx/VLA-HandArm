# MCP Server 环境变量配置示例
# 复制为 .env 并填入实际值

# ============================================================================
# Bridge 连接配置
# ============================================================================
# 本地测试（bridge 在同一台机器）
ROBOT_BRIDGE_URL=http://host.docker.internal:9000

# 云端部署（bridge 在用户机器，通过隧道暴露）
# ROBOT_BRIDGE_URL=https://random-words.trycloudflare.com

# Bridge 认证 token（和用户共享，必须一致）
ROBOT_BRIDGE_TOKEN=a8f3k2j9d8s7f6h5g4j3k2l1m0n9b8v7

# ============================================================================
# 安全配置
# ============================================================================
# 模式: auto(自动检测) | lan(局域网,无鉴权) | public(公网,强制鉴权)
# ⚠️ 云端部署必须设为 public
MCP_SECURITY_MODE=public

# API Keys（逗号分隔，给 AI 客户端用）
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEYS=key1-for-client-a,key2-for-client-b

# CORS 白名单（逗号分隔，public 模式必须指定）
# MCP_CORS_ORIGINS=https://your-frontend.com,https://another-domain.com

# ============================================================================
# 本地开发快捷配置
# ============================================================================
# 如果要本地全套跑（bridge + mcp server 都在本机）:
# ROBOT_BRIDGE_URL=http://host.docker.internal:9000
# ROBOT_BRIDGE_TOKEN=  # 留空,开发时方便
# MCP_SECURITY_MODE=lan
# MCP_API_KEYS=  # 留空,lan 模式不校验
