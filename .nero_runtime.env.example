# Copy to .nero_runtime.env and adjust only values that differ on this host.
NERO_HAND_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
NERO_CAN_CHANNEL=can0
NERO_FIRMWARE=auto

WEB_PORT=7860
BRIDGE_PORT=9000
MCP_PORT=8000

# Keep this stable and set the same value as MCP Server ROBOT_BRIDGE_TOKEN.
BRIDGE_TOKEN=

# Optional interpreter overrides.
# WEB_PYTHON=/home/zhang123/miniconda3/envs/lerobot-v3/bin/python
# ROS_PYTHON=/home/zhang123/miniconda3/envs/ros-humble/bin/python
# DIRECT_PYTHON=/home/zhang123/miniconda3/envs/lerobot/bin/python
# MCP_PYTHON=/home/zhang123/miniconda3/envs/lerobot/bin/python

# Optional extra import path shared by non-ROS child processes. The launcher's
# default is empty so an activated Conda/ROS shell cannot leak incompatible wheels.
# NERO_EXTRA_PYTHONPATH=
