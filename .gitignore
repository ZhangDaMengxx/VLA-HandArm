# ---- 第三方依赖(统一归档到 third_party/,单独下载,不入库)----
/third_party/dex-retargeting/
/third_party/dex-urdf/
/third_party/pinocchio-kinematics-lite/
/third_party/pyAgxArm/
/third_party/egozero/
/third_party/kinect2-middle/
/third_party/xr-teleoperate/
/third_party/unitree-sdk2/
# 项目维护的上游适配层需要入库。
!/third_party/overlays/
*.zip
*:Zone.Identifier

# ---- 生成物 / 训练输出(可重建,不入库)----
/outputs/
# 注意用 src/out/* 而非 src/out/:目录级忽略会让下面的 ! 例外失效。
src/out/*
# 例外:技能表 registry.yaml 的 trajectory 技能直接引用这两个 npz(各 ~100K)。
# 它们虽是生成物,但不入库的话新机器 clone 下来技能就跑不了,所以破例带上。
!src/out/robot_traj_nero_inspire_rgbd.npz
!src/out/robot_traj_nero_inspire_rgb.npz
# Rerun 可视化录制(诊断用,可重建,体积大)
*.rrd
# build_nero_inspire.py 生成(含绝对路径,换机需重建)
src/assets/nero_inspire_right.urdf

# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- 编辑器/系统 / 工具 ----
.vscode/
.idea/
.DS_Store
.claude/
20200709-subject-01/

# ---- 大文件(超 GitHub 单文件 100M 上限,git 装不下)----
# 数据集压缩包 12G,解出来就是上面已忽略的 20200709-subject-01/
20200709-subject-01.tar.gz
*.tar.gz
# 117M 全手网格,URDF/代码都没引用(URDF 用的是 1M 的"适配法兰.stl",那个入库)
assets/nero_description/meshes/nero_RH56DF.stl

# ---- 大文件 (>100M, GitHub拒绝) ----
# 117M 完整手部mesh，URDF已用适配法兰版(1M)
assets/arm/meshes/nero_RH56DF.stl
# 构建缓存，可重建
src/build_urdf/_cache/

# MCP Server 部署相关
mcp_server/.env
mcp_server/robot-mcp-server.tar
mcp_server/deploy-package.tar.gz
mcp_server.7z

# 用户包
user-package/
user-install-package.tar.gz

